# --- Ingesta de archivos (Iteración 1) ---

# Tamaño máximo de archivo permitido para carga (en MB)
MAX_UPLOAD_SIZE_MB=100

# Extensiones de archivo permitidas (separadas por coma)
ALLOWED_EXTENSIONS=.csv

# Zona horaria de las fechas que se muestran en mensajes al usuario
# (ej. "El archivo 'X' ya fue cargado como Sesión N el 07/10/2026 07:42")
DISPLAY_TIMEZONE=America/Guayaquil

# Tamaño de bloque (bytes) con el que la subida se copia a disco en streaming
UPLOAD_CHUNK_BYTES=1048576

# Filas por sentencia COPY en el Load (todas en una sola transacción). Mantiene
# cada sentencia por debajo del statement_timeout del servidor (2 min en Supabase)
LOAD_BATCH_ROWS=50000

# --- Resiliencia de la conexión a la base ---
# Segundos máximos para abrir una conexión
DB_CONNECT_TIMEOUT_SECONDS=10
# Reintentos de la conexión inicial de una carga y espera base entre ellos
# (segundos; se duplica en cada reintento). Solo se reintenta ANTES de empezar
# el Load: si la conexión cae a mitad, se hace rollback total y queda "failed".
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_BACKOFF_SECONDS=2.0
# TCP keepalives (segundos / cantidad de sondeos): evitan que el pooler o un
# NAT corten una conexión que parece inactiva durante un proceso largo
DB_KEEPALIVES_IDLE_SECONDS=30
DB_KEEPALIVES_INTERVAL_SECONDS=10
DB_KEEPALIVES_COUNT=5

# --- Avance, latido y ejecuciones interrumpidas ---
# Segundos mínimos entre escrituras de avance/latido dentro de una misma etapa
HEARTBEAT_MIN_INTERVAL_SECONDS=5.0
# Minutos sin latido tras los que una ejecución en "processing" se marca como
# fallida ("interrumpida"). Debe ser mucho mayor que la duración de un lote de
# COPY o de la etapa más lenta (~10 s medidos con 345k filas)
STALE_EXECUTION_MINUTES=10

# --- Limpieza de archivos temporales en data/input/ (al arrancar la app) ---
# Solo toca archivos con prefijo de upload_id, nunca los colocados a mano
ORPHAN_CLEANUP_ENABLED=true
# Horas tras las que se borra un archivo subido que nunca se procesó
ORPHAN_UPLOAD_MAX_AGE_HOURS=24

# Directorios de datos (relativos a la raíz del proyecto)
DATA_INPUT_DIR=data/input
DATA_PROCESSED_DIR=data/processed
DATA_REJECTED_DIR=data/rejected

# --- Base de datos (Supabase, PostgreSQL administrado) ---
# schema.sql se aplicó manualmente en el SQL Editor de Supabase; ya no hay
# un paso de inicialización automática (no se usa Docker en este proyecto).
#
# Usa el modo "Session pooler" del proyecto en Supabase (Project Settings ->
# Database -> Connection string), no "Direct connection": este equipo de
# desarrollo tiene salida IPv4, y la conexión directa de Supabase es IPv6.
# El pooler expone un host "aws-0-<region>.pooler.supabase.com" en el
# puerto 5432, con usuario "postgres.<project-ref>".
#
# Driver psycopg (v3): "postgresql+psycopg://", no el genérico "postgresql://"
# (ese usa psycopg2 por defecto, que no está en requirements.txt).
# Supabase exige SSL: agrega "?sslmode=require" al final.
#
# NO pongas aquí tu contraseña real -- este archivo sí va al repositorio.
# La cadena real, con la contraseña, va solo en tu .env local (gitignored).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
